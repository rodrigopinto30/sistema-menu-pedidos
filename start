#!/bin/bash

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}🚀 Starting Menu & Order System Ecosystem...${NC}"

echo -e "${GREEN}📦 Building and lifting containers (Docker Compose)...${NC}"
docker compose up -d --build

echo -e "${BLUE}⏳ Waiting for MySQL to be ready...${NC}"
until docker compose exec -T db mysqladmin ping -h "localhost" --silent; do
    echo -e "${YELLOW}...still waiting for database connection...${NC}"
    sleep 3
done

echo -e "${GREEN}🗄️  Processing database...${NC}"

echo -e "${BLUE}  -> Running migrations...${NC}"
docker compose exec -T backend php artisan migrate --force

echo -e "${BLUE}  -> Seeding initial/fake data...${NC}"
docker compose exec -T backend php artisan db:seed --force

echo -e "\n${GREEN}✅ System is up and running!${NC}"
echo -e "--------------------------------------------"
echo -e "🌐 Frontend:    ${GREEN}http://localhost:3000${NC}"
echo -e "🔌 Backend API: ${GREEN}http://localhost:8000${NC}"
echo -e "📊 Admin Panel: ${GREEN}http://localhost:3000/admin${NC}"
echo -e "--------------------------------------------"

echo -e "${BLUE}💡 Hint: Use 'docker compose logs -f' to see real-time output from containers.${NC}"